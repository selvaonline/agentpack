{
  "name": "@selvaonline/agentpack",
  "version": "0.1.1",
  "description": "Define your AI agent team in one YAML file — get a LangGraph supervisor, a live agent-network UI, an auto-generated MCP server, and a behavioral eval harness. TypeScript, batteries included.",
  "type": "module",
  "license": "MIT",
  "author": "Selvakumar Murugesan (https://www.linkedin.com/in/selvaonline/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selvaonline/agentpack.git"
  },
  "homepage": "https://github.com/selvaonline/agentpack#readme",
  "bugs": "https://github.com/selvaonline/agentpack/issues",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "langgraph",
    "mcp",
    "mcp-server",
    "llm",
    "agent-framework",
    "evals",
    "typescript"
  ],
  "bin": {
    "agentpack": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "!**/.env"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@langchain/core": "^0.3.5",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^4.19.2",
    "tsx": "^4.16.2",
    "yaml": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
